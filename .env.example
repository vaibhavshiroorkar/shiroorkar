# Copy to .env.local for local development, and add the same keys in Vercel.

# Public URL the site is served from. Used for canonical links, sitemap and share cards.
NEXT_PUBLIC_SITE_URL=https://uday.shiroorkar.com

# Inquiry form email delivery (https://resend.com). Without both values the form
# tells visitors it is not live yet and offers email instead. It never fakes success.
RESEND_API_KEY=
INQUIRY_TO=shiroorkarur@gmail.com
# Must be on a domain verified in Resend. The default sandbox sender only delivers
# to the Resend account owner's address.
INQUIRY_FROM="Shiroorkar website <onboarding@resend.dev>"

# Set to true on a preview deploy to show placeholder and unverified content with badges.
NEXT_PUBLIC_SHOW_PENDING=false
